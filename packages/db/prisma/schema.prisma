generator client {
  provider = "prisma-client-js"
  output   = "../generated/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  firstName String?
  lastName  String?
  createdAt DateTime @default(now())

  memberships      Membership[]
  documentsCreated Document[]        @relation("DocumentsCreated")
  versionsCreated  DocumentVersion[] @relation("VersionsCreated")
  draftsCreated    DocumentDraft[]   @relation("DraftsCreated")
  draftsProposed   DocumentDraft[]   @relation("DraftsProposed")
  reviews          Review[]          @relation("ReviewsCreated")
  lineComments     LineComment[]     @relation("LineCommentsAuthored")
  sessions Session[]
  auditLogs        AuditLog[]
  tasksCreated     Task[]            @relation("TasksCreated")
  tasksAssigned    Task[]            @relation("TasksAssigned")
}

model Job {
  id          String    @id @default(cuid())
  type        String
  payload     Json?
  // valid values: queued | running | succeeded | failed | dead
  status      String    @default("queued")
  attempts    Int       @default(0)
  maxAttempts Int       @default(3)
  runAt       DateTime  @default(now())
  lockedAt    DateTime?
  lockedBy    String?
  lastError   String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([status, runAt])
  @@index([lockedAt])
}

model Workspace {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())

  memberships      Membership[]
  documents        Document[]
  documentVersions DocumentVersion[]
  documentDrafts   DocumentDraft[]
  reviews          Review[]
  lineComments     LineComment[]
  documentSearches DocumentSearch[]
  auditLogs        AuditLog[]
  tasks            Task[]
}

model Membership {
  workspaceId String
  userId      String
  role        String   @default("reviewer")
  createdAt   DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([workspaceId, userId])
  @@index([userId])
}

model Document {
  id          String   @id @default(cuid())
  workspaceId String
  title       String
  createdById String?
  createdAt   DateTime @default(now())
  archivedAt  DateTime?

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy User?     @relation("DocumentsCreated", fields: [createdById], references: [id], onDelete: SetNull)

  versions DocumentVersion[]
  drafts   DocumentDraft[]
  tasks    Task[]

  @@index([workspaceId, archivedAt, createdAt])
}

model DocumentVersion {
  id          String   @id @default(cuid())
  workspaceId String
  documentId  String
  version     Int
  blobId      String
  sha256      String
  sizeBytes   Int
  mimeType    String
  originalFilename String?
  createdById String?
  createdAt   DateTime @default(now())

  workspace Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  document  Document       @relation(fields: [documentId], references: [id], onDelete: Cascade)
  blob      Blob           @relation(fields: [blobId], references: [id], onDelete: Restrict)
  createdBy User?          @relation("VersionsCreated", fields: [createdById], references: [id], onDelete: SetNull)
  search    DocumentSearch?
  basedDrafts DocumentDraft[] @relation("DraftBaseVersion")

  @@unique([documentId, version])
  @@index([documentId])
  @@index([workspaceId, createdAt])
  @@index([sha256])
}

model DocumentDraft {
  id            String   @id @default(cuid())
  workspaceId   String
  documentId    String
  baseVersionId String
  title         String
  content       String
  // valid values: draft | in_review | changes_requested | published | abandoned
  status        String   @default("draft")
  contentFormat String   @default("plain")
  editorKey     String?  @unique
  artifactSha256 String?
  artifactSizeBytes Int?
  artifactMimeType String?
  artifactOriginalFilename String?
  summary       String?
  proposedById  String?
  proposedAt    DateTime?
  closedAt      DateTime?
  createdById   String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  workspace   Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  document    Document        @relation(fields: [documentId], references: [id], onDelete: Cascade)
  baseVersion DocumentVersion @relation("DraftBaseVersion", fields: [baseVersionId], references: [id], onDelete: Cascade)
  createdBy   User?           @relation("DraftsCreated", fields: [createdById], references: [id], onDelete: SetNull)
  proposedBy  User?           @relation("DraftsProposed", fields: [proposedById], references: [id], onDelete: SetNull)
  reviews     Review[]
  lineComments LineComment[]

  @@index([workspaceId, documentId, status])
  @@index([documentId])
  @@index([baseVersionId])
  @@index([createdById])
  @@index([proposedById])
  // Also carries the partial unique index "DocumentDraft_one_active_per_document"
  // (documentId WHERE status IN ('draft','in_review','changes_requested')), declared in raw SQL
  // in migrations/20260806195500_merge_proposed_change_into_draft. Prisma cannot express partial
  // unique indexes, so `prisma db push` will not recreate it — use migrations for this table.
}

model Review {
  id          String   @id @default(cuid())
  workspaceId String
  draftId     String
  reviewerId  String?
  // valid values: approved | changes_requested | commented
  state       String
  body        String?
  createdAt   DateTime @default(now())

  workspace Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  draft     DocumentDraft @relation(fields: [draftId], references: [id], onDelete: Cascade)
  reviewer  User?         @relation("ReviewsCreated", fields: [reviewerId], references: [id], onDelete: SetNull)

  @@index([workspaceId, draftId])
  @@index([draftId])
  @@index([reviewerId])
}

model Blob {
  id         String   @id @default(cuid())
  sha256     String   @unique
  sizeBytes  Int
  storageKey String   @unique
  createdAt  DateTime @default(now())

  versions DocumentVersion[]
}

model DocumentSearch {
  versionId   String   @id
  workspaceId String
  plainText   String?
  format      String   @default("plain")
  indexedAt   DateTime @default(now())
  status      String   @default("pending")
  error       String?

  version   DocumentVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)
  workspace Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
}

model AuditLog {
  id          String   @id @default(cuid())
  workspaceId String
  actorId     String?
  action      String
  entityType  String
  entityId    String
  ip          String?
  userAgent   String?
  metadata    Json?
  createdAt   DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  actor     User?     @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([workspaceId, createdAt])
  @@index([workspaceId])
  @@index([actorId])
}

model Task {
  id          String    @id @default(cuid())
  workspaceId String
  documentId  String
  title       String
  assigneeId  String?
  createdById String?
  status      String    @default("open")
  createdAt   DateTime  @default(now())
  completedAt DateTime?

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  document  Document  @relation(fields: [documentId], references: [id], onDelete: Cascade)
  assignee  User?     @relation("TasksAssigned", fields: [assigneeId], references: [id], onDelete: SetNull)
  createdBy User?     @relation("TasksCreated", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([workspaceId, documentId])
  @@index([documentId])
  @@index([assigneeId])
}

model LineComment {
  id            String   @id @default(cuid())
  workspaceId   String
  draftId       String
  authorId      String?
  diffLineIndex Int
  body          String
  createdAt     DateTime @default(now())

  workspace Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  draft     DocumentDraft @relation(fields: [draftId], references: [id], onDelete: Cascade)
  author    User?         @relation("LineCommentsAuthored", fields: [authorId], references: [id], onDelete: SetNull)

  @@index([workspaceId, draftId])
  @@index([draftId])
}

model Session {
  id                  String    @id @default(cuid())
  userId              String
  refreshTokenHash    String    @unique
  rotatedFromId       String?
  expiresAt           DateTime
  revokedAt           DateTime?
  createdAt           DateTime  @default(now())
  ip                  String?
  userAgent           String?

  user                User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}
