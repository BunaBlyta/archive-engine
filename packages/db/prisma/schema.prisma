generator client {
  provider = "prisma-client-js"
  output   = "../generated/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  createdAt DateTime @default(now())

  memberships      Membership[]
  documentsCreated Document[]        @relation("DocumentsCreated")
  versionsCreated  DocumentVersion[] @relation("VersionsCreated")
  draftsCreated    DocumentDraft[]   @relation("DraftsCreated")
  proposedChangesOpened ProposedChange[] @relation("ProposedChangesOpened")
  reviews          Review[]          @relation("ReviewsCreated")
  sessions Session[]
  auditLogs        AuditLog[]
}

model Job {
  id          String    @id @default(cuid())
  type        String
  payload     Json?
  // valid values: queued | running | succeeded | failed | dead
  status      String    @default("queued")
  attempts    Int       @default(0)
  maxAttempts Int       @default(3)
  runAt       DateTime  @default(now())
  lockedAt    DateTime?
  lockedBy    String?
  lastError   String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([status, runAt])
  @@index([lockedAt])
}

model Workspace {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())

  memberships      Membership[]
  documents        Document[]
  documentVersions DocumentVersion[]
  documentDrafts   DocumentDraft[]
  proposedChanges  ProposedChange[]
  reviews          Review[]
  documentSearches DocumentSearch[]
  auditLogs        AuditLog[]
}

model Membership {
  workspaceId String
  userId      String
  role        String   @default("member")
  createdAt   DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([workspaceId, userId])
  @@index([userId])
}

model Document {
  id          String   @id @default(cuid())
  workspaceId String
  title       String
  createdById String?
  createdAt   DateTime @default(now())
  archivedAt  DateTime?

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy User?     @relation("DocumentsCreated", fields: [createdById], references: [id], onDelete: SetNull)

  versions DocumentVersion[]
  drafts   DocumentDraft[]
  proposedChanges ProposedChange[]

  @@index([workspaceId, archivedAt, createdAt])
}

model DocumentVersion {
  id          String   @id @default(cuid())
  workspaceId String
  documentId  String
  version     Int
  blobId      String
  sha256      String
  sizeBytes   Int
  mimeType    String
  originalFilename String?
  createdById String?
  createdAt   DateTime @default(now())

  workspace Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  document  Document       @relation(fields: [documentId], references: [id], onDelete: Cascade)
  blob      Blob           @relation(fields: [blobId], references: [id], onDelete: Restrict)
  createdBy User?          @relation("VersionsCreated", fields: [createdById], references: [id], onDelete: SetNull)
  search    DocumentSearch?
  basedDrafts DocumentDraft[] @relation("DraftBaseVersion")

  @@unique([documentId, version])
  @@index([documentId])
  @@index([workspaceId, createdAt])
  @@index([sha256])
}

model DocumentDraft {
  id            String   @id @default(cuid())
  workspaceId   String
  documentId    String
  baseVersionId String
  title         String
  content       String
  // valid values: draft | proposed | published | abandoned
  status        String   @default("draft")
  createdById   String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  workspace   Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  document    Document        @relation(fields: [documentId], references: [id], onDelete: Cascade)
  baseVersion DocumentVersion @relation("DraftBaseVersion", fields: [baseVersionId], references: [id], onDelete: Cascade)
  createdBy   User?           @relation("DraftsCreated", fields: [createdById], references: [id], onDelete: SetNull)
  proposedChange ProposedChange?

  @@index([workspaceId, documentId, status])
  @@index([documentId])
  @@index([baseVersionId])
  @@index([createdById])
}

model ProposedChange {
  id          String    @id @default(cuid())
  workspaceId String
  documentId  String
  draftId     String    @unique
  // valid values: open | approved | changes_requested | published | closed
  status      String    @default("open")
  summary     String?
  openedById  String?
  openedAt    DateTime  @default(now())
  closedAt    DateTime?

  workspace Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  document  Document      @relation(fields: [documentId], references: [id], onDelete: Cascade)
  draft     DocumentDraft @relation(fields: [draftId], references: [id], onDelete: Cascade)
  openedBy  User?         @relation("ProposedChangesOpened", fields: [openedById], references: [id], onDelete: SetNull)
  reviews   Review[]

  @@index([workspaceId, documentId, status])
  @@index([documentId])
  @@index([openedById])
}

model Review {
  id               String   @id @default(cuid())
  workspaceId      String
  proposedChangeId String
  reviewerId       String?
  // valid values: approved | changes_requested | commented
  state            String
  body             String?
  createdAt        DateTime @default(now())

  workspace      Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  proposedChange ProposedChange @relation(fields: [proposedChangeId], references: [id], onDelete: Cascade)
  reviewer       User?          @relation("ReviewsCreated", fields: [reviewerId], references: [id], onDelete: SetNull)

  @@index([workspaceId, proposedChangeId])
  @@index([proposedChangeId])
  @@index([reviewerId])
}

model Blob {
  id         String   @id @default(cuid())
  sha256     String   @unique
  sizeBytes  Int
  storageKey String   @unique
  createdAt  DateTime @default(now())

  versions DocumentVersion[]
}

model DocumentSearch {
  versionId   String   @id
  workspaceId String
  plainText   String?
  indexedAt   DateTime @default(now())
  status      String   @default("pending")
  error       String?

  version   DocumentVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)
  workspace Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
}

model AuditLog {
  id          String   @id @default(cuid())
  workspaceId String
  actorId     String?
  action      String
  entityType  String
  entityId    String
  ip          String?
  userAgent   String?
  metadata    Json?
  createdAt   DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  actor     User?     @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([workspaceId, createdAt])
  @@index([workspaceId])
  @@index([actorId])
}

model Session {
  id                  String    @id @default(cuid())
  userId              String
  refreshTokenHash    String    @unique
  rotatedFromId       String?
  expiresAt           DateTime
  revokedAt           DateTime?
  createdAt           DateTime  @default(now())
  ip                  String?
  userAgent           String?

  user                User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}
