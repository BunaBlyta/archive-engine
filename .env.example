# Database
DATABASE_URL=postgresql://archive:archive_password@localhost:5433/archive_db

# MinIO / Object Storage
MINIO_ENDPOINT=http://localhost:9000
MINIO_ROOT_USER=archive_minio
MINIO_ROOT_PASSWORD=archive_minio_secret
MINIO_BUCKET=archive-blobs

# API
PORT=3000

# Comma-separated list of frontend origins allowed to call the API with credentials.
WEB_ORIGINS=http://localhost:5173,http://localhost:3001

# Number of trusted proxy hops in front of the API (e.g. a load balancer). 0 means the API is
# reached directly and req.ip should be the connecting socket's address, matching local dev.
# Set this to the number of hops when deploying behind a reverse proxy/load balancer so req.ip
# (used in audit logs and session records) reflects the real client, not the proxy.
TRUST_PROXY_HOPS=0

# Auth
JWT_ACCESS_SECRET=your_access_token_secret
JWT_REFRESH_SECRET=your_refresh_token_secret

# ONLYOFFICE Docs Community (local Docker)
ONLYOFFICE_URL=http://localhost:8080
EDITOR_PUBLIC_API_URL=http://host.docker.internal:3000
# Must be the same value the documentserver container is given (see docker-compose.yml).
ONLYOFFICE_JWT_SECRET=your_onlyoffice_jwt_secret

# Rate limiting (per IP, 15-minute window). Defaults are strict in production and
# deliberately high elsewhere so local development and E2E runs are not throttled.
AUTH_RATE_LIMIT_MAX=100
GLOBAL_RATE_LIMIT_MAX=2000
