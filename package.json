{
  "name": "archive-engine",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "api",
    "worker",
    "web",
    "packages/*"
  ],
  "scripts": {
    "typecheck": "npm run typecheck -w api && npm run typecheck -w web",
    "dev": "concurrently -n api,worker,web -c blue,magenta,green \"npm run dev:api\" \"npm run dev:worker\" \"npm run dev:web\"",
    "dev:api": "npm run dev -w api",
    "dev:worker": "npm run dev -w worker",
    "dev:web": "npm run dev -w web",
    "build:web": "npm run build -w web",
    "db:generate": "npm run db:generate -w @archive/db",
    "db:migrate": "npm run db:migrate -w @archive/db",
    "db:studio": "npm run db:studio -w @archive/db",
    "build:storage": "npm run build -w @archive/storage"
  },
  "devDependencies": {
    "concurrently": "^9.2.4",
    "dotenv-cli": "^11.0.0"
  }
}
